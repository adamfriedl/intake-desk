# LLM — OpenRouter is the default (OpenAI-compatible)
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4.1-mini

# Optional fallbacks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg://intake:intake@localhost:5432/intake_desk

# RAG / embeddings (also via OpenRouter when OPENROUTER_API_KEY is set)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Pipeline
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
REQUIRE_CITATIONS=true
